<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ModelBar</AssemblyName>
    <RootNamespace>ModelBar.App</RootNamespace>
    <ApplicationIcon>Assets\ModelBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <EmbeddedResource Include="Assets\ModelBar.ico" LogicalName="ModelBar.ico" />
    <ProjectReference Include="../ModelBar.Core/ModelBar.Core.csproj" />
  </ItemGroup>
</Project>
